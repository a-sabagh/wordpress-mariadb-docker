# --- MariaDB ---
MARIADB_USER=wpmari_user
MARIADB_PASSWORD=change_me
MARIADB_DATABASE=wpmari_db
MARIADB_ROOT_PASSWORD=change_me_root

# --- WordPress ---
# 1 = debug on, 0 = off (do NOT use TRUE/FALSE: any non-empty string is truthy)
WORDPRESS_DEBUG=1
WORDPRESS_PORT=8080

# --- Adminer ---
ADMINER_PORT=8082

# --- Host user (run `id -u` and `id -g` on Linux/macOS) ---
UID=1000
GID=1000
